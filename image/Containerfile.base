# SPDX-License-Identifier: GPL-3.0-only
ARG FEDORA_BASE=registry.fedoraproject.org/fedora@sha256:de3396aa9d2452c5affd4a0b6eff9d3d0a7f3af58e243827790963c30e2d5e2c
FROM ${FEDORA_BASE}

# El contenedor de Fedora solo instala textos en inglés: añade el español (diálogos de Qt, programas).
RUN echo '%_install_langs en_US:es_ES:es' > /etc/rpm/macros.image-language-conf

# Sistema mínimo, sesión gráfica y red.
RUN dnf -y --setopt=install_weak_deps=False install \
    kernel-core kernel-modules-core kernel-modules dracut systemd systemd-udev systemd-pam \
    sway greetd python3-pyside6 qt6-qtwayland python3-gobject python3-pygments qt6-qttranslations \
    mesa-dri-drivers mesa-libEGL mesa-libGL \
    dbus-daemon polkit kbd dejavu-sans-fonts dejavu-sans-mono-fonts glibc-langpack-es \
    python3-evdev \
    NetworkManager NetworkManager-wifi iputils curl \
    foot sudo git nano python3-pip flatpak plocate \
    pipewire wireplumber pipewire-pulseaudio pipewire-utils bluez brightnessctl mako libnotify NetworkManager-tui \
    libreoffice-writer \
    && dnf clean all && dnf makecache \
    && flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo \
    && flatpak update --appstream
