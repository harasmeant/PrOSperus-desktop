ARG FEDORA_BASE=registry.fedoraproject.org/fedora@sha256:de3396aa9d2452c5affd4a0b6eff9d3d0a7f3af58e243827790963c30e2d5e2c
FROM ${FEDORA_BASE}
RUN dnf -y --setopt=install_weak_deps=False install \
    kernel-core kernel-modules-core dracut systemd systemd-udev \
    cage greetd python3-pyside6 qt6-qtwayland python3-gobject \
    mesa-dri-drivers mesa-libEGL mesa-libGL \
    dbus-daemon polkit kbd dejavu-sans-fonts glibc-langpack-es \
    && dnf clean all
