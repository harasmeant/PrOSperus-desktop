# SPDX-License-Identifier: GPL-3.0-only
# SwayFX (Sway con desenfoque, esquinas y sombras) no está en Debian: se compila aparte, con
# su wlroots 0.19 (trixie trae la 0.18), en versiones fijas por commit y sin dejar compiladores
# en el sistema. SwayFX 0.5.1 (la última para wlroots 0.18) dejaba recuadros sin repintar.
FROM localhost/prosperus-debian-base:dev AS swayfx
RUN apt-get update && apt-get install -y build-essential meson ninja-build pkg-config cmake scdoc \
        wayland-protocols libwayland-dev libjson-c-dev libpcre2-dev libpango1.0-dev \
        libcairo2-dev libgdk-pixbuf-2.0-dev libinput-dev libxkbcommon-dev libdrm-dev libgles-dev \
        libegl-dev libgbm-dev libevdev-dev libsystemd-dev libpixman-1-dev libseat-dev hwdata \
        libdisplay-info-dev libliftoff-dev libudev-dev xwayland libxcb1-dev libxcb-icccm4-dev \
        libxcb-composite0-dev libxcb-render0-dev libxcb-res0-dev libxcb-xfixes0-dev libxcb-ewmh-dev
WORKDIR /src
# fetch <repo> <etiqueta> <commit>: clona la etiqueta y comprueba que no se ha movido.
RUN printf '#!/bin/sh\nset -e\ngit clone --depth 1 --branch "$2" "$1" "$4"\ntest "$(git -C "$4" rev-parse HEAD)" = "$3"\n' \
        > /usr/local/bin/fetch && chmod +x /usr/local/bin/fetch
RUN fetch https://gitlab.freedesktop.org/wlroots/wlroots.git 0.19.2 8c9e6b7c9f3c5344f456e97dc29dcd8d8a5f015b wlroots \
    && meson setup wlroots/build wlroots --prefix=/usr --buildtype=release -Dexamples=false \
       -Drenderers=gles2 -Dbackends=drm,libinput -Dxwayland=enabled -Dallocators=gbm \
    && ninja -C wlroots/build && DESTDIR=/out ninja -C wlroots/build install && ninja -C wlroots/build install
RUN fetch https://github.com/wlrfx/scenefx.git 0.4.1 0f069970b410195aa5908d98c6fb41f3f0cd6e76 scenefx \
    && meson setup scenefx/build scenefx --prefix=/usr --buildtype=release -Dexamples=false \
    && ninja -C scenefx/build && DESTDIR=/out ninja -C scenefx/build install && ninja -C scenefx/build install
RUN fetch https://github.com/WillPower3309/swayfx.git 0.5.3 660c1197b6626326ce35a0241a6a00e80dddcbd6 swayfx \
    && meson setup swayfx/build swayfx --prefix=/usr --buildtype=release -Dman-pages=disabled \
    && ninja -C swayfx/build && DESTDIR=/out ninja -C swayfx/build install \
    && rm -rf /out/usr/include /out/usr/lib/*/pkgconfig /out/etc

FROM localhost/prosperus-debian-base:dev
# El paquete sway trae las dependencias; su binario se aparta (dpkg-divert) para que
# una actualización de Debian no pise el de SwayFX.
COPY --from=swayfx /out/usr /tmp/swayfx/usr
RUN for bin in sway swaymsg swaynag; do \
        dpkg-divert --local --rename --divert "/usr/bin/$bin.debian" --add "/usr/bin/$bin"; \
    done \
    && cp -a /tmp/swayfx/usr/. /usr/ && rm -rf /tmp/swayfx && ldconfig && sway --version \
    && ! ldd /usr/bin/sway | grep "not found" \
    && apt-get install -y qt6-svg-plugins qt6-image-formats-plugins wl-mirror input-remapper \
       grim slurp wl-clipboard cliphist swaylock swayidle fuzzel xdg-user-dirs wob swappy playerctl \
       eza bat fastfetch btop papirus-icon-theme breeze-cursor-theme \
       dconf-cli gsettings-desktop-schemas xdg-desktop-portal xdg-desktop-portal-gtk xdg-desktop-portal-wlr \
    && apt-get clean \
    && ln -s /usr/bin/batcat /usr/local/bin/bat
# Tema adw-gtk3 y símbolos de Nerd Fonts, que no están en Debian:
# versiones fijas comprobadas con su SHA-256.
RUN apt-get install -y xz-utils && curl -fsSL -o /tmp/adw.tar.xz \
        https://github.com/lassekongo83/adw-gtk3/releases/download/v6.5/adw-gtk3v6.5.tar.xz \
    && echo 'a81780fadfc432be0fc3d89c4ebb41aa28e4f032d42c36f9789c57dd10cfa41c  /tmp/adw.tar.xz' | sha256sum -c - \
    && tar -xJf /tmp/adw.tar.xz -C /usr/share/themes && rm /tmp/adw.tar.xz \
    && curl -fsSL -o /tmp/nerd.tar.xz \
        https://github.com/ryanoasis/nerd-fonts/releases/download/v3.5.1/NerdFontsSymbolsOnly.tar.xz \
    && echo '01172f37db8543edb102e5cb5c64101c9f4686630804d49b419aa07b23a69996  /tmp/nerd.tar.xz' | sha256sum -c - \
    && mkdir -p /usr/share/fonts/nerd-symbols && tar -xJf /tmp/nerd.tar.xz -C /usr/share/fonts/nerd-symbols \
    && cp /usr/share/fonts/nerd-symbols/10-nerd-font-symbols.conf /etc/fonts/conf.d/ \
    && rm /tmp/nerd.tar.xz && fc-cache -f
COPY desktop/prosperus /usr/lib/prosperus/prosperus
COPY demo-system /usr/share/prosperus/demo
COPY LICENSE /usr/share/licenses/prosperus/LICENSE
COPY image/rootfs/ /
# Debian regenera el initramfs de cada /boot/vmlinuz-* al instalar firmware o núcleos;
# vmlinuz-prosperus no es un núcleo instalado y rompería apt: ese paso se desactiva.
# foot 1.21 de Debian aún llama [colors] a lo que 1.22 llama [colors-dark].
RUN echo 'LANG=es_ES.UTF-8' > /etc/default/locale \
    && sed -i 's/^\[colors-dark\]/[colors]/' /etc/xdg/foot/foot.ini \
    && chmod 0755 /usr/bin/prosperus /usr/bin/prosperus-windows /usr/bin/prosperus-fondos /usr/bin/prosperus-ramas /usr/bin/prosperus-instalar /usr/bin/prosperus-claude /usr/bin/prosperus-terminal /usr/bin/prosperus-bloquear /usr/bin/prosperus-captura /usr/bin/prosperus-portapapeles /usr/bin/prosperus-osd /usr/bin/prosperus-handle /usr/libexec/prosperus-session /usr/libexec/prosperus-persistence /usr/libexec/prosperus-client \
    && useradd --create-home --uid 1000 --shell /bin/bash prosperus \
    && passwd --lock root \
    && passwd --delete prosperus \
    && install -D -o prosperus -g prosperus -m 0644 /usr/share/prosperus/btop.conf /home/prosperus/.config/btop/btop.conf \
    && chown -R prosperus:prosperus /home/prosperus \
    && usermod -aG sudo,video,audio,input prosperus \
    && chmod 0440 /etc/sudoers.d/prosperus-vm \
    && systemctl enable NetworkManager.service \
    && systemctl enable greetd.service \
    && systemctl enable input-remapper-daemon.service \
    && systemctl set-default graphical.target \
    && systemctl mask getty@tty1.service \
    && mkdir -p /boot /usr/share/prosperus /var/log/journal \
    && dpkg-query -W -f='${Package}-${Version}.${Architecture}\n' | sort > /usr/share/prosperus/packages.txt \
    && dconf update \
    && python3 -m compileall -q /usr/lib/prosperus/prosperus \
    && updatedb \
    && kernel_version="$(ls /usr/lib/modules | sort -V | tail -1)" \
    && dpkg-divert --local --rename --divert /etc/kernel/postinst.d/dracut.debian --add /etc/kernel/postinst.d/dracut \
    && printf '#!/bin/sh\n# PrOSperus: arranca con /boot/initramfs-prosperus.img; Debian no regenera otros.\nexit 0\n' \
       > /etc/kernel/postinst.d/dracut && chmod 0755 /etc/kernel/postinst.d/dracut \
    && rm -f /boot/initrd.img-* \
    && cp "/boot/vmlinuz-$kernel_version" /boot/vmlinuz-prosperus \
    && dracut --force --no-hostonly --no-hostonly-cmdline \
       --add-drivers 'virtio_pci virtio_blk virtio_gpu ext4' \
       /boot/initramfs-prosperus.img "$kernel_version" > /usr/share/prosperus/dracut-build.log 2>&1 \
    && truncate -s 0 /etc/machine-id
LABEL org.opencontainers.image.title="PrOSperus desktop (Debian)"
LABEL org.opencontainers.image.licenses="GPL-3.0-only"
LABEL org.opencontainers.image.version="0.5.0"
CMD ["/sbin/init"]
