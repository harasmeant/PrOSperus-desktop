#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=PrOSperus
export QT_QPA_PLATFORM=wayland
# pixman (software) basta con una gráfica, pero no puede copiar la imagen a una segunda
# (HDMI en la NVIDIA): "Renderer did not support importing DMA-BUFs" y esa salida no enciende.
export WLR_RENDERER=pixman
export XKB_DEFAULT_LAYOUT=es
export XCURSOR_THEME=breeze_cursors XCURSOR_SIZE=24
# El plano de cursor de la NVIDIA no acepta el formato que pide wlroots ("Failed to pick
# cursor plane format"): el puntero parpadea o se queda congelado en el HDMI. Cursor por software.
export WLR_NO_HARDWARE_CURSORS=1
# greetd arranca en /: sin esto, todo lo que abre Sway (la consola incluida) empieza en la raíz.
cd "$HOME" || true
# Las descargas llegan a una carpeta de entrada y el escritorio las reparte en el proyecto
# que se ve (incoming.py). Los navegadores (Firefox, Zen…) usan XDG_DOWNLOAD_DIR sin preguntar.
incoming=$HOME/.local/share/prosperus/entrantes
mkdir -p "$incoming"
# GLib (navegadores, también en Flatpak) lee la carpeta de ~/.config/user-dirs.dirs, no la variable.
dirs=${XDG_CONFIG_HOME:-$HOME/.config}/user-dirs.dirs
mkdir -p "${dirs%/*}"
touch "$dirs"
grep -v '^XDG_DOWNLOAD_DIR=' "$dirs" > "$dirs.tmp"
echo 'XDG_DOWNLOAD_DIR="$HOME/.local/share/prosperus/entrantes"' >> "$dirs.tmp"
mv "$dirs.tmp" "$dirs"
export XDG_DOWNLOAD_DIR=$incoming
# greetd no lee /etc/profile.d: sin esto los programas de Flathub no salen en Aplicaciones.
# /usr/share/prosperus/xdg va primero: sus .desktop sustituyen a los del sistema (btop).
export XDG_DATA_DIRS="/usr/share/prosperus/xdg:${XDG_DATA_HOME:-$HOME/.local/share}/flatpak/exports/share:/var/lib/flatpak/exports/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
# En equipos reales el framebuffer provisional (simpledrm) aparece antes que el
# driver de la gráfica; si Sway lo toma, la pantalla queda negra al cargar amdgpu/i915.
# Se espera a las gráficas reales y se usan todas, la de arranque (boot_vga) primero:
# en portátiles híbridos el HDMI suele colgar de la NVIDIA.
# NVIDIA solo cuenta con el controlador propietario instalado (nouveau está bloqueado).
# Debian lo llama nvidia-current(-open); ruta completa porque /usr/sbin no está en su PATH.
nvidia_module=
for name in nvidia nvidia-current-open nvidia-current; do
    /usr/sbin/modinfo -n "$name" >/dev/null 2>&1 && { nvidia_module=$name; break; }
done
expected=0
for dev in /sys/bus/pci/devices/*; do
    case $(cat "$dev/class" 2>/dev/null) in 0x0300*|0x0302*) ;; *) continue ;; esac
    [ "$(cat "$dev/vendor")" = 0x10de ] && [ -z "$nvidia_module" ] && continue
    expected=$((expected + 1))
done
i=0
while [ $i -lt 30 ]; do
    boot= rest= count=0
    for card in /sys/class/drm/card[0-9]*; do
        case $card in *-*) continue ;; esac
        driver=$(basename "$(readlink -f "$card/device/driver" 2>/dev/null)")
        case $driver in ''|simple-framebuffer|simpledrm|efi-framebuffer) continue ;; esac
        # Sin salidas (NVIDIA sin modo KMS) Sway no puede usarla y no arranca: se deja fuera.
        ls -d "$card"-* >/dev/null 2>&1 || continue
        count=$((count + 1))
        if [ -z "$boot" ] && [ "$(cat "$card/device/boot_vga" 2>/dev/null)" = 1 ]; then
            boot=/dev/dri/${card##*/}
        else
            rest=${rest:+$rest:}/dev/dri/${card##*/}
        fi
    done
    # Con todas las esperadas (o al agotar la espera con alguna), se arranca.
    if [ $count -gt 0 ] && { [ $count -ge $expected ] || [ $i -ge 20 ]; }; then
        export WLR_DRM_DEVICES=${boot:+$boot${rest:+:}}$rest
        break
    fi
    sleep 0.5
    i=$((i + 1))
done
# ~/.config/prosperus/graficas con "nvidia": la NVIDIA dibuja y va primero. Con la de
# arranque primero, cada fotograma del HDMI (que cuelga de la NVIDIA) se copia de la AMD a
# la NVIDIA, y con la 550 esa copia parpadea al redibujar y puede romper (Xid 13 en sway).
prefer=${XDG_CONFIG_HOME:-$HOME/.config}/prosperus/graficas
if [ "$(cat "$prefer" 2>/dev/null)" = nvidia ]; then
    nv= others=
    for d in $(echo "$WLR_DRM_DEVICES" | tr ':' ' '); do
        case $(basename "$(readlink -f "/sys/class/drm/${d##*/}/device/driver" 2>/dev/null)") in
            nvidia) nv=${nv:+$nv:}$d ;;
            *) others=${others:+$others:}$d ;;
        esac
    done
    [ -n "$nv" ] && export WLR_DRM_DEVICES=$nv${others:+:$others}
fi
# Con el controlador propietario de NVIDIA cargado, Sway se niega a arrancar sin
# --unsupported-gpu (pantalla negra tras instalarlo).
flags=
grep -q '^nvidia ' /proc/modules && flags=--unsupported-gpu
# Sway sustituye a Cage: permite varias ventanas sobre el mapa de proyectos.
run_sway() {
    echo "Gráficas para Sway: ${WLR_DRM_DEVICES:-automático} [$WLR_RENDERER] ($count de $expected); ${flags:-sin opciones}" | systemd-cat -t prosperus-diag
    dbus-run-session -- systemd-cat --identifier=prosperus-session sway $flags --config /etc/sway/prosperus.conf
}
case $WLR_DRM_DEVICES in *:*) ;; *) run_sway; exit ;; esac
# Con varias gráficas la copia entre ellas puede fallar (amdgpu + NVIDIA 550: ninguna
# pantalla se enciende, Sway sigue vivo sin salidas y cae al abrir el escritorio).
# La configuración de Sway avisa con este archivo si no hay ninguna pantalla activa;
# entonces se prueba con la NVIDIA de principal y, si tampoco, solo con la de arranque.
flag=${XDG_RUNTIME_DIR:-/tmp}/prosperus-sin-pantallas
export PROSPERUS_GPU_FLAG=$flag
first=${WLR_DRM_DEVICES%%:*} others=${WLR_DRM_DEVICES#*:}
# Al copiar a la otra gráfica, wlroots calcula mal la zona a repintar: al mover ventanas o el
# ratón se quedan trozos viejos y se ve el escritorio detrás. Se repinta la pantalla entera.
export WLR_SCENE_DEBUG_DAMAGE=rerender
# Con varias gráficas se usa GLES2 (sí copia entre gráficas); el último intento,
# solo la de arranque, vuelve a pixman como red de seguridad. El wlroots 0.18 de Debian sí
# trae Vulkan (el que no lo traía era el de SwayFX): para probarlo, "vulkan" en
# ~/.config/prosperus/renderizador. Si deja sin pantallas, siguen los intentos con GLES2.
# Si Vulkan falla, antes de cambiar de principal se reintenta GLES2 con el mismo orden: con la
# NVIDIA de principal la eDP queda apagada. Con la 550, Vulkan no importa los búferes de la AMD
# en la NVIDIA (getMemoryFdPropertiesKHR: ERROR_UNKNOWN) y el HDMI no se enciende.
renderer=$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/prosperus/renderizador" 2>/dev/null)
retry=
[ "${renderer:-gles2}" != gles2 ] && retry="gles2 $WLR_DRM_DEVICES"
for attempt in "${renderer:-gles2} $WLR_DRM_DEVICES" ${retry:+"$retry"} "gles2 $others:$first" "pixman $first"; do
    export WLR_RENDERER=${attempt%% *} WLR_DRM_DEVICES=${attempt#* }
    devices=$WLR_DRM_DEVICES
    # No usar WLR_DRM_NO_MODIFIERS: con amdgpu + NVIDIA 550 no crea el búfer del HDMI
    # ("multi-GPU destination buffer"), fallan ambas combinaciones y el HDMI queda negro.
    rm -f "$flag"
    started=$(date +%s)
    run_sway
    status=$?
    # Sin aviso y tras más de 20 s, es una salida normal (cerrar sesión).
    [ ! -e "$flag" ] && [ $(( $(date +%s) - started )) -ge 20 ] && exit $status
    echo "Sin pantallas con $devices [$WLR_RENDERER]; se prueba otra combinación" | systemd-cat -t prosperus-diag
done
exit 1
