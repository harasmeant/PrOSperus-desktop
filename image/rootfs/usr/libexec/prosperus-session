#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=PrOSperus
export QT_QPA_PLATFORM=wayland
export WLR_RENDERER=pixman
export XKB_DEFAULT_LAYOUT=es
# Sway sustituye a Cage: permite varias ventanas sobre el mapa de proyectos.
exec dbus-run-session -- sway --config /etc/sway/prosperus.conf
