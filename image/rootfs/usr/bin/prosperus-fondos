#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
# Selector de fondo: cambia solo el fondo de la carpeta desde la que se abre.
# Sin la barra de Qt: la ventana dibuja su propia cabecera.
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export PYTHONPATH=/usr/lib/prosperus
exec /usr/bin/python3 -m prosperus.wallpaper_picker "$@"
