#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
# Consola Foot en la carpeta del proyecto que se ve en el escritorio y con su tono
# (los publica el escritorio en $XDG_RUNTIME_DIR/prosperus). Sin ellos, carpeta personal
# y colores del sistema. Los argumentos van a foot (p. ej. una orden que ejecutar).
state=${XDG_RUNTIME_DIR:-/nonexistent}/prosperus
dir=$HOME
[ -r "$state/folder" ] && read -r folder < "$state/folder" && [ -d "$folder" ] && dir=$folder
set -- --working-directory "$dir" "$@"
[ -r "$state/foot.ini" ] && set -- --config "$state/foot.ini" "$@"
exec foot "$@"
