#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
# Bloquea la pantalla con el fondo del proyecto desenfocado (Super+L y swayidle).
# Si ya está bloqueada no abre otro swaylock.
pgrep -x swaylock >/dev/null && exit 0
export PYTHONPATH=/usr/lib/prosperus
exec /usr/bin/python3 -m prosperus.lock_screen
