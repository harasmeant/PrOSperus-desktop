FROM localhost/prosperus-base:dev
# Duplicar pantallas: Sway no tiene modo espejo propio. Input Remapper: botones del ratón
# y teclas reasignados (preajustes en /usr/share/prosperus/input-remapper-2).
# SwayFX (Sway con desenfoque, esquinas y sombras) desde su COPR oficial; el resto, de Fedora:
# capturas, portapapeles, bloqueo, consola (eza, bat, fastfetch, btop) y selector (fuzzel).
RUN curl -fsSL -o /etc/yum.repos.d/swayfx.repo \
        https://copr.fedorainfracloud.org/coprs/swayfx/swayfx/repo/fedora-44/swayfx-swayfx-fedora-44.repo \
    && dnf -y --setopt=install_weak_deps=False install --allowerasing swayfx \
    && dnf -y --setopt=install_weak_deps=False install wl-mirror input-remapper \
       grim slurp wl-clipboard cliphist swaylock swayidle fuzzel xdg-user-dirs wob swappy playerctl \
       eza bat fastfetch btop papirus-icon-theme breeze-cursor-theme \
       adw-gtk3-theme dconf gsettings-desktop-schemas xdg-desktop-portal xdg-desktop-portal-gtk xdg-desktop-portal-wlr \
    && dnf clean all
# Símbolos de Nerd Fonts (iconos de eza), que no están en Fedora:
# versión fija comprobada con su SHA-256.
RUN curl -fsSL -o /tmp/nerd.tar.xz \
        https://github.com/ryanoasis/nerd-fonts/releases/download/v3.5.1/NerdFontsSymbolsOnly.tar.xz \
    && echo '01172f37db8543edb102e5cb5c64101c9f4686630804d49b419aa07b23a69996  /tmp/nerd.tar.xz' | sha256sum -c - \
    && mkdir -p /usr/share/fonts/nerd-symbols && tar -xJf /tmp/nerd.tar.xz -C /usr/share/fonts/nerd-symbols \
    && cp /usr/share/fonts/nerd-symbols/10-nerd-font-symbols.conf /etc/fonts/conf.d/ \
    && rm /tmp/nerd.tar.xz && fc-cache -f
COPY desktop/prosperus /usr/lib/prosperus/prosperus
COPY demo-system /usr/share/prosperus/demo
COPY LICENSE /usr/share/licenses/prosperus/LICENSE
COPY image/rootfs/ /
RUN chmod 0755 /usr/bin/prosperus /usr/bin/prosperus-windows /usr/bin/prosperus-fondos /usr/bin/prosperus-ramas /usr/bin/prosperus-instalar /usr/bin/prosperus-askpass /usr/bin/prosperus-claude /usr/bin/prosperus-terminal /usr/bin/prosperus-bloquear /usr/bin/prosperus-captura /usr/bin/prosperus-portapapeles /usr/bin/prosperus-osd /usr/bin/prosperus-handle /usr/libexec/prosperus-session /usr/libexec/prosperus-persistence /usr/libexec/prosperus-client \
    && useradd --create-home --uid 1000 --shell /bin/bash prosperus \
    && passwd --lock root \
    && passwd --delete prosperus \
    && install -D -o prosperus -g prosperus -m 0644 /usr/share/prosperus/btop.conf /home/prosperus/.config/btop/btop.conf \
    && chown -R prosperus:prosperus /home/prosperus \
    && usermod -aG wheel,video,audio prosperus \
    && chmod 0440 /etc/sudoers.d/prosperus-vm \
    && systemctl enable NetworkManager.service \
    && systemctl enable greetd.service \
    && systemctl enable input-remapper.service \
    && systemctl set-default graphical.target \
    && systemctl mask getty@tty1.service \
    && mkdir -p /boot /usr/share/prosperus /var/log/journal \
    && rpm -qa --qf '%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}\n' | sort > /usr/share/prosperus/packages.txt \
    && dconf update \
    && python3 -m compileall -q /usr/lib/prosperus/prosperus \
    && updatedb \
    && kernel_version="$(ls /usr/lib/modules | sort -V | tail -1)" \
    && cp "/usr/lib/modules/$kernel_version/vmlinuz" /boot/vmlinuz-prosperus \
    && dracut --force --no-hostonly --no-hostonly-cmdline \
       --add-drivers 'virtio_pci virtio_blk virtio_gpu ext4' \
       /boot/initramfs-prosperus.img "$kernel_version" > /usr/share/prosperus/dracut-build.log 2>&1 \
    && truncate -s 0 /etc/machine-id
LABEL org.opencontainers.image.title="PrOSperus desktop development VM"
LABEL org.opencontainers.image.licenses="GPL-3.0-only"
LABEL org.opencontainers.image.version="0.5.0"
CMD ["/sbin/init"]
