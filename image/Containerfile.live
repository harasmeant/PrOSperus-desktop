# SPDX-License-Identifier: GPL-3.0-only
FROM localhost/prosperus:dev
# dracut-live supplies the SquashFS/overlay boot logic missing from plain dracut.
# PAM registers the seat and XDG_RUNTIME_DIR needed by Sway/Wayland.
# Firmware: Wi-Fi y gráficas habituales para arrancar el USB en equipos reales.
RUN dnf -y --setopt=install_weak_deps=False install dracut-live systemd-pam \
    e2fsprogs util-linux \
    iwlwifi-mvm-firmware iwlwifi-dvm-firmware realtek-firmware atheros-firmware \
    brcmfmac-firmware mt7xxx-firmware amd-gpu-firmware intel-gpu-firmware \
    && dnf clean all
# Asistente Claude: Claude Code (instalador oficial) en la carpeta del usuario,
# que la partición PROSPERUS_DATA conserva junto con el inicio de sesión.
RUN runuser -l prosperus -c 'curl -fsSL https://claude.ai/install.sh | bash' \
    && test -x /home/prosperus/.local/bin/claude
# Versión de la imagen: la capa persistente del sistema (PROSPERUS_DATA/sistema/<versión>)
# solo se reutiliza con la misma ISO. dnf no instala núcleos: el arranque usa siempre
# el de la ISO y otro solo ocuparía el USB.
RUN date -u +%Y%m%d%H%M%S > /usr/share/prosperus/build-id \
    && printf 'excludepkgs=kernel,kernel-core,kernel-modules,kernel-modules-core,kernel-modules-extra\n' >> /etc/dnf/dnf.conf
RUN printf '# Live root is mounted by the initramfs.\n' > /etc/fstab \
    && systemctl enable prosperus-persistence.service \
    && kernel_version="$(ls /usr/lib/modules | sort -V | tail -1)" \
    && dracut --force --no-hostonly --no-hostonly-cmdline \
       --add 'dmsquash-live prosperus-persist' \
       --add-drivers 'virtio_pci virtio_blk virtio_scsi virtio_gpu sr_mod isofs squashfs overlay loop usb_storage uas xhci_pci ehci_pci sd_mod nvme' \
       /boot/initramfs-prosperus.img "$kernel_version" \
       > /usr/share/prosperus/dracut-live-build.log 2>&1 \
    && rpm -qa --qf '%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}\n' | sort > /usr/share/prosperus/packages.txt
